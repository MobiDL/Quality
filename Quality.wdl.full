version 1.0

import "modules/sambamba.wdl" as runSambamba
import "modules/GATK4.wdl" as runGatk
import "modules/utilities.wdl" as runUtilities
import "modules/identito.wdl" as runIdentito
import "modules/covreport2.wdl" as runCovReport

workflow Quality {
    meta {
        author: "Felix VANDERMEEREN"
        email: "felix.vandermeeren(at)chu-montpellier.fr"
        version: "0.0.1"
        date: "2026-11-26"
    }
    input {
        ## resources
        Int cpuHigh = 24
        Int cpuLow = 1
        # Int avxCpu
        Int memoryLow = 2500
        Int memoryHigh = 12000
        # memoryLow = scattered tasks =~ mem_per_cpu in HPC or not
        # memoryHigh = one cpu tasks => high mem ex 10Gb

        ## Global
        String sample
        File bamFile
        File bamIndex
        String outDir

        File refFasta
        File refFai = refFasta + ".fai"
        File refDict

        File intervalTargetFile
        File intervalBaitBed = intervalTargetFile  # Default to 'targetBed'

        ## computePoorCoverage
        Int bedtoolsLowCoverage = 20
        Int bedToolsSmallInterval = 20
        String genomeVersion = "hg38"

        ## computeCoverage
        Int minCovBamQual = 30

        ## Identito (default = SNPXplex. rsIDs order here will be maintained)
        String idList = "rs11702450,rs843345,rs1058018,rs8017,rs3738494,rs1065483,rs2839181,rs11059924,rs2075144,rs6795772,rs456261,rs1131620,rs2231926,rs352169,rs3739160"

        ## covreport
        String covReportDir
        File geneFile
    }

    call runSambamba.flagstat {
        input:
            Queue = defQueue,
            threads = cpuHigh,
            memory = memoryLow,
            name = sample,
            outputPath = outDir,
            bamIndex = bamIndex,
            bam = bam
            
    }

    call runGatk.collectMultipleMetrics {
        input:
            Queue = defQueue,
            threads = cpuLow,
            memory = memoryHigh,
            name = sample,
            outputPath = outDir,
            refFasta = refFasta,
            bamIndex = bamIndex,
            bam = bam
    }

    call runGatk.collectInsertSizeMetrics {
        input:
            Queue = defQueue,
            threads = cpuLow,
            memory = memoryHigh,
            name = sample,
            outputPath = outDir,
            refFasta = refFasta,
            bamIndex = bamIndex,
            bam = bam
    }

    # collectHsMetrics only support 'GATK intervals' as input (not BED)
    call runGatk.bedToPicardIntervalList as bedToPicardIntervalListTarget {
        input:
            threads = cpuLow,
            memory = memoryLow,
            name = sample,
            outputPath = outDir,
            refDict = refDict,
            intervalTargetFile = intervalTargetFile
    }
    call runGatk.bedToPicardIntervalList as bedToPicardIntervalListBait {
        input:
            threads = cpuLow,
            memory = memoryLow,
            name = sample,
            outPath = outDir,
            bait = true,
            refDict = refDict,
            intervalTargetFile = intervalBaitBedFile
    }

    call runGatk.collectHsMetrics {
        input:
            Queue = defQueue,
            threads = cpuLow,
            memory = memoryHigh,
            name = sample,
            outputPath = outDir,
            refFasta = refFasta,
            refFai = refFai,
            bamIndex = bamIndex,
            bam = bam,
            baitIntervals = bedToPicardIntervalListBait.picardIntervals,
            targetIntervals = bedToPicardIntervalListTarget.picardIntervals
    }

    call runComputeUtilities.computeGenomecov {
        input:
            Queue = defQueue,
            threads = cpuLow,
            memory = memoryHigh,
            name = sample,
            outputPath = outDir,
            genomeVersion = genomeVersion,
            IntervalBedFile = intervalTargetFile,
            BedtoolsLowCoverage = bedtoolsLowCoverage,
            bamIndex = bamIndex,
            bam = bam
    }

    call runUtilities.computePoorCoverage {
        input:
            Queue = defQueue,
            threads = cpuLow,
            memory = memoryHigh,
            name = sample,
            outputPath = outDir,
            genomeVersion = genomeVersion,
            BedToolsSmallInterval = bedToolsSmallInterval,
            GenomecovFile = computeGenomecov.genomecovFile
    }

    call runUtilities.samtoolsBedCov {
        input:
            Queue = defQueue,
            threads = cpuLow,
            memory = memoryHigh,
            name = sample,
            outputPath = outDir,
            IntervalBedFile = intervalTargetFile,
            bam = bam,
            bamIndex = bamIndex,
            MinCovBamQual = minCovBamQual
    }

    call runUtilities.computeCoverage {
        input:
            Queue = defQueue,
            threads = cpuLow,
            memory = memoryHigh,
            name = sample,
            outputPath = outDir,
            BedCovFile = samtoolsBedCov.BedCovFile
    }

    call runUtilities.computeCoverageClamms {
        input:
            Queue = defQueue,
            threads = cpuLow,
            memory = memoryHigh,
            name = sample,
            outputPath = outDir,
            BedCovFile = samtoolsBedCov.BedCovFile
    }

    call runCovReport.covReport as covreport {
        input:
            threads = cpuLow,
            memory = memoryLow,
            name = sample,
            outputPath = outDir,
            covReportDir = covReportDir,
            bam = bam,
            bamIndex = bamIndex,
            genomeVersion = genomeVersion,
            geneFile = geneFile
    }

    output {
        File? Qualityfile = multiqc.multiqcHtml
    }

}
